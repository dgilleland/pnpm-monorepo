{
  "name": "cli-count-up",
  "version": "0.1.0",
  "description": "A CLI tool to count up and display numbers as words.",
  "bin": {
    "cli-count-up": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --out-dir dist --watch",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "inquirer": "^9.2.16",
    "count-up": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "tsup": "^7.2.0",
    "rimraf": "^5.0.5",
    "@types/node": "^20.8.10",
  "@types/commander": "2.12.5",
    "@types/inquirer": "^9.0.7"
  },
  "private": true
}
